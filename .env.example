# Local development environment variables. Copy to .env and adjust.

# PostgreSQL connection string used when running locally (on Upsun the
# credentials come from PLATFORM_RELATIONSHIPS instead).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm

# Secret used to sign captcha tokens. Set this as an Upsun project variable so
# tokens stay valid across restarts and instances.
CAPTCHA_SECRET=change-me

# Port the HTTP server listens on (Upsun provides this automatically).
PORT=3000
