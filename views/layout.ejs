<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> &middot; Simple CRM</title>
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0f13" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&amp;display=swap"
    />
    <link rel="stylesheet" href="/static/css/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <span class="brand"><span class="brand__mark" aria-hidden="true"></span>Simple CRM</span>
        <nav class="nav" aria-label="Main">
          <a href="/">New message</a>
          <a class="nav__cta" href="/messages">Messages</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <%- include(view) %>
    </main>

    <footer class="site-footer">
      <p>Simple CRM</p>
    </footer>
  </body>
</html>
